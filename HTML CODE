        <div style="display:flex;gap:0;border:1.5px solid var(--border);border-radius:8px;overflow:hidden;margin-bottom:14px">
          <button id="mode-month-btn" onclick="setReportMode('month')" style="flex:1;padding:8px;font-size:12px;font-weight:700;border:none;cursor:pointer;font-family:DM Sans,sans-serif;background:var(--azure);color:#fff">By Month</button>
          <button id="mode-range-btn" onclick="setReportMode('range')" style="flex:1;padding:8px;font-size:12px;font-weight:700;border:none;cursor:pointer;font-family:DM Sans,sans-serif;background:var(--surface);color:var(--sub)">By Date Range</button>
        </div>
        <div id="report-mode-month">
          <div class="g2" style="margin-bottom:14px">
            <div class="field"><label>Month</label>
              <select id="report-month">
                <option value="0">January</option><option value="1">February</option><option value="2">March</option>
                <option value="3">April</option><option value="4">May</option><option value="5">June</option>
                <option value="6">July</option><option value="7">August</option><option value="8">September</option>
                <option value="9">October</option><option value="10">November</option><option value="11">December</option>
              </select>
            </div>
            <div class="field"><label>Year</label><input type="number" id="report-year" value="2026" min="2026" max="2099"></div>
          </div>
        </div>
        <div id="report-mode-range" style="display:none">
          <div class="g2" style="margin-bottom:14px">
            <div class="field"><label>From Date</label>
              <div class="input-with-cal">
                <input type="text" id="report-from" placeholder="01 Jan 2026" autocomplete="off">
                <button type="button" class="cal-btn" onclick="openReportFromPicker()"></button>
              </div>
            </div>
            <div class="field"><label>To Date</label>
              <div class="input-with-cal">
                <input type="text" id="report-to" placeholder="31 Jan 2026" autocomplete="off">
                <button type="button" class="cal-btn" onclick="openReportToPicker()"></button>
              </div>
            </div>
          </div>
        </div>
        <div id="monthly-preview" style="margin-bottom:14px"></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button class="btn-nsc" onclick="downloadMonthlyReport()">⬇ Download Excel</button>
          <button class="btn-success" onclick="_archiveCurrentReport()" style="font-size:12px">Archive Month</button>
          <button class="btn-ghost" onclick="closeMonthlyReport()">Close</button>
        </div>
      </div>
    </div>
  </main>
</div>

<div id="print-only-container" style="display:none;position:fixed;inset:0;z-index:99999;background:#fff;padding:0"></div>

</body>
</html>

