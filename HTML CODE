      <div style="display:flex;flex-direction:column;gap:5px"><label style="font-size:10px;color:#8A9BAC;font-weight:600;letter-spacing:.07em;text-transform:uppercase">Nom. VLSFO</label><input type="number" id="er-vlsfo-nom" min="0" step="1" style="font-size:13px;padding:9px 12px;border:1.5px solid rgba(13,27,42,.10);border-radius:8px;font-family:DM Mono,monospace;outline:none;width:100%;background:#F8FAFC;color:#8A9BAC"></div>
