/* ─── INIT ─── */
async function init() {
  setSyncStatus('syncing', 'Connecting to shared workspace…');

  // Load saved records first
  await loadSharedRecords(true);

  // Try to load shared state
  const loaded = await loadSharedState(false);

  if (!loaded) {
    // Nothing in shared storage — add default barge + sample vessels
    function sd(d,mon,yr,hh,mm){return `${pad(d)} ${MO[mon]} ${yr} ${pad(hh)}:${pad(mm)}`;}
    addBarge({name:'Barge 1',vcap:5000,mcap:1000,vrob:0,mrob:0,vbuf:500,mbuf:150,vtph:300,mtph:100});
    addVessel({name:'SIFSAFAH',area:'FUJ-A',type:'VLSFO',qty:840,spec:'ISO 8217:2010',agent:'WSS',manifold:'VESSEL MANIFOLD',lc:'24-26 Apr 2026',eta:sd(24,3,2026,8,0),paq:'yes'});
