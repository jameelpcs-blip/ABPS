
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ABPS — Auto Bunker Planning System</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=DM+Mono:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,300&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<style>
/* ═══════════════════════════════════════════════════════════
   ABPS Design System v3 — Premium Maritime Operations
   Reference: matching provided screenshots exactly
   Clean white sidebar · Dark navy topbar · Page routing
═══════════════════════════════════════════════════════════ */
:root {
  /* Brand palette */
  --navy:      #0B1726;
  --navy2:     #0F2038;
  --ink:       #0D1B2A;
  --slate:     #2E4A6B;
  --azure:     #1565C0;
  --azure-lt:  #E8F0FE;
  --azure-bd:  #90B8F8;
  --teal:      #00796B;
  --teal-lt:   #E0F2F1;
  --amber:     #B45309;
  --amber-lt:  #FEF3C7;
  --amber-bd:  #F59E0B;
  --red:       #B91C1C;
  --red-lt:    #FEE2E2;
  --red-bd:    #FCA5A5;
  --green:     #15803D;
  --green-lt:  #DCFCE7;
  --green-bd:  #86EFAC;
  --purple:    #7C3AED;
  --purple-lt: #EDE9FE;

  /* Surfaces */
  --bg:        #F1F5F9;
  --surface:   #FFFFFF;
  --surface2:  #F8FAFC;
  --border:    #E2E8F0;
  --border2:   #F1F5F9;
  --text:      #0F172A;
  --sub:       #475569;
  --muted:     #94A3B8;

  /* Layout */
  --topbar-h:  56px;
  --syncbar-h: 32px;
  --sidebar-w: 232px;
  --radius:    10px;
  --radius-sm: 7px;
  --radius-xs: 5px;

  /* Shadows */
  --sh-xs: 0 1px 2px rgba(0,0,0,.04);
  --sh-sm: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
  --sh-md: 0 4px 6px rgba(0,0,0,.05), 0 10px 15px rgba(0,0,0,.07);
  --sh-lg: 0 10px 25px rgba(0,0,0,.1), 0 4px 6px rgba(0,0,0,.05);
  --sh-xl: 0 25px 50px rgba(0,0,0,.15);
}

/* ── Reset ── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;height:100%}
body{font-family:'DM Sans',system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;font-size:13.5px;line-height:1.5;-webkit-font-smoothing:antialiased}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(0,0,0,.12);border-radius:4px}
button{font-family:'DM Sans',sans-serif}
input,select,textarea{font-family:'DM Sans',sans-serif}

/* ── Animations ── */
@keyframes fadeUp{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.45}}
@keyframes livePulse{0%,100%{box-shadow:0 0 0 0 rgba(34,197,94,.4)}70%{box-shadow:0 0 0 6px rgba(34,197,94,0)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes slideInLeft{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)}}

/* ════════════════════════════════════════
   SYNC BANNER
════════════════════════════════════════ */
.sync-banner{
  height:var(--syncbar-h);
  background:var(--navy);
  display:flex;align-items:center;
  padding:0 1.5rem;gap:10px;
  position:sticky;top:0;z-index:300;
  border-bottom:1px solid rgba(255,255,255,.05);
}
.sync-dot{width:6px;height:6px;border-radius:50%;background:#22C55E;flex-shrink:0;animation:livePulse 2s infinite}
.sync-dot.syncing{background:#F59E0B;animation:spin .8s linear infinite;border-radius:2px}
.sync-dot.error{background:#F87171;animation:none}
.sync-msg{font-family:'DM Mono',monospace;font-size:10.5px;color:rgba(255,255,255,.45);flex:1;letter-spacing:.02em}
.sync-actions{display:flex;gap:6px}
.sync-btn{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.65);border-radius:5px;padding:3px 10px;font-size:10.5px;font-weight:600;cursor:pointer;transition:all .15s;white-space:nowrap}
.sync-btn:hover{background:rgba(255,255,255,.14);color:#fff}

/* ════════════════════════════════════════
   TOPBAR — exact reference match
════════════════════════════════════════ */
.topbar{
  height:var(--topbar-h);
  background:var(--surface);
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;
  padding:0 1.5rem;gap:14px;
  position:sticky;top:var(--syncbar-h);z-index:250;
  box-shadow:var(--sh-xs);
}
.topbar-logo-wrap{display:flex;align-items:center;gap:10px;flex-shrink:0}
.topbar-logo{
  width:32px;height:32px;
  background:linear-gradient(135deg,var(--azure) 0%,#0D47A1 100%);
  border-radius:8px;
  display:flex;align-items:center;justify-content:center;
  font-family:'DM Mono',monospace;font-size:9px;font-weight:700;
  color:#fff;letter-spacing:.5px;
  box-shadow:0 2px 6px rgba(21,101,192,.35);
}
.topbar-app-name{
  font-family:'Fraunces',serif;
  font-size:15px;font-weight:600;
  color:var(--ink);letter-spacing:-.02em;line-height:1.1;
}
.topbar-app-sub{font-size:10px;color:var(--muted);font-family:'DM Mono',monospace;letter-spacing:.02em}
.topbar-page-title{
  font-size:14px;font-weight:600;color:var(--ink);
  padding-left:14px;
  border-left:1px solid var(--border);
  line-height:1.2;
}
.topbar-page-sub{font-size:11px;color:var(--muted);margin-top:1px}
.topbar-spacer{flex:1}
.topbar-live{
  display:flex;align-items:center;gap:6px;
  background:var(--green-lt);border:1px solid var(--green-bd);
  border-radius:20px;padding:4px 11px 4px 8px;
  font-size:10.5px;font-weight:600;color:var(--green);
}
.topbar-live-dot{width:6px;height:6px;border-radius:50%;background:#22C55E;animation:livePulse 2s infinite}
.topbar-clock{
  font-family:'DM Mono',monospace;font-size:10px;
  color:var(--muted);white-space:nowrap;
  padding:4px 10px;border:1px solid var(--border);
  border-radius:6px;background:var(--surface2);
}
.topbar-btn-reset{
  display:flex;align-items:center;gap:5px;
  background:var(--red-lt);border:1px solid var(--red-bd);
  color:var(--red);border-radius:6px;
  padding:5px 11px;font-size:11.5px;font-weight:600;
  cursor:pointer;transition:all .15s;white-space:nowrap;
}
.topbar-btn-reset:hover{background:var(--red);color:#fff}
.hamburger{
  display:none;align-items:center;justify-content:center;
  width:32px;height:32px;background:none;
  border:1px solid var(--border);border-radius:6px;
  cursor:pointer;color:var(--sub);transition:all .15s;flex-shrink:0;
}
.hamburger:hover{background:var(--surface2);color:var(--ink)}

/* ════════════════════════════════════════
   LAYOUT
════════════════════════════════════════ */
.layout{display:flex;min-height:calc(100vh - var(--topbar-h) - var(--syncbar-h))}

/* ════════════════════════════════════════
   SIDEBAR — exact reference match
   White background, clean nav items
════════════════════════════════════════ */
.sidebar{
  width:var(--sidebar-w);flex-shrink:0;
  background:var(--surface);
  border-right:1px solid var(--border);
  display:flex;flex-direction:column;
  position:sticky;
  top:calc(var(--topbar-h) + var(--syncbar-h));
  height:calc(100vh - var(--topbar-h) - var(--syncbar-h));
  overflow-y:auto;overflow-x:hidden;
}
.sidebar-section-label{
  font-size:9.5px;font-weight:700;
  letter-spacing:.12em;text-transform:uppercase;
  color:var(--muted);
  padding:14px 18px 5px;
  margin-top:4px;
}
.sidebar-item{
  display:flex;align-items:center;gap:10px;
  padding:8.5px 18px;
  font-size:13px;font-weight:500;
  color:var(--sub);text-decoration:none;
  cursor:pointer;
  border-left:2px solid transparent;
  transition:all .13s;
  position:relative;
  margin:1px 0;
}
.sidebar-item:hover{background:#F8FAFC;color:var(--ink)}
.sidebar-item.active{
  background:var(--azure-lt);
  color:var(--azure);font-weight:600;
  border-left-color:var(--azure);
}
.sidebar-icon{
  width:16px;height:16px;flex-shrink:0;
  opacity:.6;transition:opacity .13s;
}
.sidebar-item.active .sidebar-icon{opacity:1;color:var(--azure)}
.sidebar-item:hover .sidebar-icon{opacity:.85}
.sidebar-badge{
  margin-left:auto;
  font-size:10px;font-weight:700;
  background:var(--azure);color:#fff;
  border-radius:10px;padding:1px 7px;
  min-width:18px;text-align:center;
}
.sidebar-badge.amber{background:var(--amber)}
.sidebar-badge.red{background:var(--red)}
.sidebar-divider{height:1px;background:var(--border);margin:8px 16px}

/* ════════════════════════════════════════
   MAIN / PAGE AREAS
════════════════════════════════════════ */
.main{flex:1;min-width:0;overflow:hidden}

/* Page = one section shown at a time */
.page{display:none;padding:1.5rem 1.75rem;animation:fadeUp .22s ease;min-height:100%}
.page.active{display:block}

/* ── Page header ── */
.page-header{margin-bottom:1.5rem}
.page-title{
  font-family:'Fraunces',serif;
  font-size:20px;font-weight:600;
  color:var(--ink);letter-spacing:-.025em;
  margin-bottom:3px;line-height:1.2;
}
.page-subtitle{font-size:12px;color:var(--muted)}
.page-header-row{
  display:flex;align-items:flex-start;justify-content:space-between;
  gap:16px;flex-wrap:wrap;
  padding-bottom:1.25rem;
  border-bottom:1px solid var(--border);
  margin-bottom:1.5rem;
}
.page-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap;flex-shrink:0}

/* ── Section headers ── */
.sec-hdr{
  display:flex;align-items:center;justify-content:space-between;
  margin:1.5rem 0 .85rem;flex-wrap:wrap;gap:8px;
}
.sec-label{
  font-size:10px;font-weight:700;
  color:var(--sub);letter-spacing:.12em;text-transform:uppercase;
  display:flex;align-items:center;gap:8px;
}
.sec-label::before{
  content:'';display:block;
  width:3px;height:14px;
  background:linear-gradient(180deg,var(--azure),var(--teal));
  border-radius:2px;flex-shrink:0;
}

/* ════════════════════════════════════════
   METRIC / KPI CARDS — reference style
════════════════════════════════════════ */
.kpi-grid{display:grid;gap:12px;margin-bottom:1.25rem}
.kpi-grid-5{grid-template-columns:repeat(5,1fr)}
.kpi-grid-4{grid-template-columns:repeat(4,1fr)}
.kpi-grid-3{grid-template-columns:repeat(3,1fr)}
.kpi-grid-2{grid-template-columns:repeat(2,1fr)}

.kpi-card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:16px 18px;
  box-shadow:var(--sh-sm);
  transition:box-shadow .2s,transform .15s;
  position:relative;overflow:hidden;
  cursor:default;
}
.kpi-card:hover{box-shadow:var(--sh-md);transform:translateY(-1px)}
.kpi-card-icon{
  position:absolute;right:14px;top:14px;
  width:30px;height:30px;border-radius:8px;
  display:flex;align-items:center;justify-content:center;
  opacity:.85;
}
.kpi-label{
  font-size:9.5px;font-weight:700;
  letter-spacing:.1em;text-transform:uppercase;
  color:var(--muted);margin-bottom:10px;
  display:block;
}
.kpi-value{
  font-size:24px;font-weight:700;
  letter-spacing:-.04em;
  font-family:'DM Mono',monospace;
  line-height:1;display:block;
  margin-bottom:6px;
}
.kpi-sub{font-size:10.5px;color:var(--muted)}
.kpi-delta{
  font-size:10.5px;font-weight:600;
  display:inline-flex;align-items:center;gap:3px;margin-top:4px;
}
.kpi-delta.up{color:var(--green)}
.kpi-delta.down{color:var(--red)}
.kpi-delta.warn{color:var(--amber)}

/* Color tokens for KPI */
.kpi-azure .kpi-value{color:var(--azure)}
.kpi-azure .kpi-card-icon{background:var(--azure-lt);color:var(--azure)}
.kpi-teal .kpi-value{color:var(--teal)}
.kpi-teal .kpi-card-icon{background:var(--teal-lt);color:var(--teal)}
.kpi-amber .kpi-value{color:var(--amber)}
.kpi-amber .kpi-card-icon{background:var(--amber-lt);color:var(--amber)}
.kpi-red .kpi-value{color:var(--red)}
.kpi-red .kpi-card-icon{background:var(--red-lt);color:var(--red)}
.kpi-green .kpi-value{color:var(--green)}
.kpi-green .kpi-card-icon{background:var(--green-lt);color:var(--green)}
.kpi-ink .kpi-value{color:var(--ink)}
.kpi-ink .kpi-card-icon{background:var(--surface2);color:var(--ink)}

/* ════════════════════════════════════════
   CARDS
════════════════════════════════════════ */
.card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:var(--radius);padding:1.25rem 1.5rem;
  margin-bottom:.85rem;box-shadow:var(--sh-sm);
}
.card-title{
  font-size:13px;font-weight:700;color:var(--ink);
  margin-bottom:12px;
  font-family:'Fraunces',serif;letter-spacing:-.01em;
}
.card-subtitle{font-size:11px;color:var(--sub);margin-bottom:12px}

/* ════════════════════════════════════════
   ALERT BANNERS — reference: yellow/red strips at top
════════════════════════════════════════ */
.alert-strip{
  display:flex;align-items:center;gap:10px;
  padding:10px 14px;border-radius:var(--radius-sm);
  margin-bottom:8px;font-size:12px;font-weight:500;
}
.alert-strip svg{flex-shrink:0;opacity:.8}
.alert-strip.critical{background:#FEF2F2;border:1px solid #FECACA;color:#991B1B}
.alert-strip.warning{background:#FFFBEB;border:1px solid #FDE68A;color:#92400E}
.alert-strip.info{background:var(--azure-lt);border:1px solid var(--azure-bd);color:#1E40AF}

/* ════════════════════════════════════════
   DATA TABLE — reference style
════════════════════════════════════════ */
.tbl-wrap{overflow-x:auto;border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--sh-sm);margin-bottom:1.25rem}
.data-tbl{width:100%;border-collapse:collapse;background:var(--surface);font-size:12.5px}
.data-tbl thead{background:#F8FAFC;border-bottom:1px solid var(--border)}
.data-tbl th{
  padding:9px 14px;text-align:left;
  font-size:9.5px;font-weight:700;
  letter-spacing:.09em;text-transform:uppercase;
  color:var(--sub);white-space:nowrap;
}
.data-tbl td{
  padding:10px 14px;border-bottom:1px solid var(--border2);
  color:var(--text);vertical-align:middle;
}
.data-tbl tr:last-child td{border-bottom:none}
.data-tbl tbody tr:hover td{background:#F8FAFC}
.data-tbl .num{font-family:'DM Mono',monospace;font-weight:600}
.data-tbl .num.azure{color:var(--azure)}
.data-tbl .num.teal{color:var(--teal)}
.data-tbl .num.red{color:var(--red)}
.data-tbl .mono{font-family:'DM Mono',monospace;font-size:11.5px}

/* ════════════════════════════════════════
   STATUS BADGES — pill style, reference
════════════════════════════════════════ */
.badge{
  display:inline-flex;align-items:center;gap:4px;
  font-size:10px;font-weight:700;
  padding:3px 8px;border-radius:20px;
  border:1px solid;letter-spacing:.03em;
  white-space:nowrap;
}
.badge-green {background:var(--green-lt);color:var(--green);border-color:var(--green-bd)}
.badge-azure {background:var(--azure-lt);color:var(--azure);border-color:var(--azure-bd)}
.badge-amber {background:var(--amber-lt);color:var(--amber);border-color:var(--amber-bd)}
.badge-red   {background:var(--red-lt);color:var(--red);border-color:var(--red-bd)}
.badge-teal  {background:var(--teal-lt);color:var(--teal);border-color:#80CBC4}
.badge-slate {background:var(--surface2);color:var(--sub);border-color:var(--border)}
.badge-purple{background:var(--purple-lt);color:var(--purple);border-color:#C4B5FD}
.badge-dot{width:5px;height:5px;border-radius:50%;background:currentColor;flex-shrink:0}

/* Dual Fuel badge */
.badge-dual{
  display:inline-flex;border-radius:20px;overflow:hidden;
  border:1px solid var(--border);font-size:9.5px;font-weight:700;
}
.badge-dual span{padding:2px 7px}
.badge-dual .v{background:var(--azure-lt);color:var(--azure)}
.badge-dual .m{background:var(--teal-lt);color:var(--teal)}

/* ════════════════════════════════════════
   FORMS & FIELDS
════════════════════════════════════════ */
.field{display:flex;flex-direction:column;gap:4px}
.field label{font-size:10px;color:var(--sub);font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.field input,.field select,.field textarea{
  font-size:13px;padding:8px 11px;
  border:1.5px solid var(--border);border-radius:var(--radius-sm);
  background:var(--surface);color:var(--text);outline:none;
  transition:border-color .15s,box-shadow .15s;width:100%;
}
.field input:hover,.field select:hover{border-color:#CBD5E1}
.field input:focus,.field select:focus,.field textarea:focus{
  border-color:var(--azure);
  box-shadow:0 0 0 3px rgba(21,101,192,.08);
}
.field input.err{border-color:var(--red);background:#FFF9F9}
.hint{font-size:11px;color:var(--muted);line-height:1.4}
.hint.ok{color:var(--green)}.hint.er{color:var(--red)}.hint.inf{color:var(--azure)}
.input-cal{display:flex;align-items:center;border:1.5px solid var(--border);border-radius:var(--radius-sm);background:var(--surface);overflow:hidden;transition:border-color .15s}
.input-cal:focus-within{border-color:var(--azure);box-shadow:0 0 0 3px rgba(21,101,192,.08)}
.input-cal input{border:none!important;box-shadow:none!important;flex:1;min-width:0}
.input-cal input:focus{outline:none;box-shadow:none}
.cal-btn{background:none;border:none;cursor:pointer;padding:0 10px;color:var(--muted);transition:color .15s;display:flex;align-items:center}
.cal-btn:hover{color:var(--azure)}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.g4{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px}
.g5{display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr;gap:12px}
.mb10{margin-bottom:10px}

/* ════════════════════════════════════════
   BUTTONS
════════════════════════════════════════ */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  padding:8px 16px;border-radius:var(--radius-sm);
  font-size:12.5px;font-weight:600;cursor:pointer;
  transition:all .18s;white-space:nowrap;border:none;
  font-family:'DM Sans',sans-serif;letter-spacing:.01em;
}
.btn-primary{background:var(--azure);color:#fff;box-shadow:0 1px 3px rgba(21,101,192,.25)}
.btn-primary:hover{background:#1251A3;box-shadow:0 4px 12px rgba(21,101,192,.35);transform:translateY(-1px)}
.btn-secondary{background:var(--surface);color:var(--sub);border:1px solid var(--border)}
.btn-secondary:hover{border-color:var(--azure);color:var(--azure);background:var(--azure-lt)}
.btn-success{background:var(--teal);color:#fff;box-shadow:0 1px 3px rgba(0,121,107,.2)}
.btn-success:hover{background:#00695C}
.btn-danger{background:var(--red-lt);color:var(--red);border:1px solid var(--red-bd)}
.btn-danger:hover{background:var(--red);color:#fff}
.btn-ghost{background:transparent;color:var(--sub);border:1px solid var(--border)}
.btn-ghost:hover{background:var(--surface2);color:var(--ink);border-color:#CBD5E1}
.btn-sm{padding:5px 11px;font-size:11.5px}
.btn-lg{padding:11px 22px;font-size:13.5px;border-radius:var(--radius)}
.btn-full{width:100%}

/* ── GENERATE CTA ── */
.btn-generate{
  background:var(--ink);color:#fff;
  padding:13px 24px;border-radius:var(--radius);
  font-size:13.5px;font-weight:700;
  box-shadow:0 4px 14px rgba(13,27,42,.28);
  width:100%;margin-bottom:1.75rem;
  display:flex;align-items:center;justify-content:center;gap:10px;
  transition:all .2s;
}
.btn-generate:hover{background:#0B2240;box-shadow:0 6px 20px rgba(13,27,42,.4);transform:translateY(-1px)}
.btn-generate svg{opacity:.7;transition:transform .2s}
.btn-generate:hover svg{transform:translateX(3px);opacity:1}

/* ── ADD button ── */
.btn-add{
  width:100%;padding:10px;
  background:var(--surface2);
  border:1.5px dashed #CBD5E1;
  border-radius:var(--radius);
  font-size:12.5px;color:var(--sub);
  cursor:pointer;font-weight:500;
  transition:all .15s;margin-bottom:.75rem;
}
.btn-add:hover{background:var(--azure-lt);border-color:var(--azure-bd);border-style:solid;color:var(--azure)}

/* ════════════════════════════════════════
   VESSEL / BARGE CARDS
════════════════════════════════════════ */
.vcard,.bcard{
  background:var(--surface);border:1px solid var(--border);
  border-radius:var(--radius);padding:1.1rem 1.35rem;
  margin-bottom:10px;box-shadow:var(--sh-sm);
  transition:box-shadow .18s,border-color .18s;
  position:relative;
}
.vcard:hover,.bcard:hover{box-shadow:var(--sh-md);border-color:#CBD5E1}
.vcard-hdr,.bcard-hdr{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:13px;padding-bottom:10px;border-bottom:1px solid var(--border2);
}
.vcard-num{
  font-family:'DM Mono',monospace;font-size:10px;font-weight:700;
  letter-spacing:.06em;color:var(--azure);
  background:var(--azure-lt);border:1px solid var(--azure-bd);
  border-radius:5px;padding:2px 9px;
}
.vcard-num.barge{color:var(--teal);background:var(--teal-lt);border-color:#80CBC4}
.rm-btn{
  font-size:11.5px;cursor:pointer;color:var(--muted);
  background:transparent;border:1px solid var(--border);
  padding:4px 10px;border-radius:var(--radius-xs);
  transition:all .15s;
}
.rm-btn:hover{background:var(--red-lt);color:var(--red);border-color:var(--red-bd)}

/* ── ETC Preview ── */
.etc-prev{
  background:var(--azure-lt);border:1px solid var(--azure-bd);
  border-radius:var(--radius-xs);padding:7px 11px;
  font-size:11px;color:#1E40AF;margin-top:7px;
  display:none;font-family:'DM Mono',monospace;
}
.etc-prev.show{display:block}
.lc-box{border-radius:var(--radius-xs);padding:7px 11px;font-size:11.5px;margin-top:7px;display:none;font-weight:500}
.lc-box.show{display:block}
.lc-box.ok{background:var(--green-lt);border:1px solid var(--green-bd);color:var(--green)}
.lc-box.warn{background:var(--amber-lt);border:1px solid var(--amber-bd);color:var(--amber)}
.lc-box.late{background:var(--red-lt);border:1px solid var(--red-bd);color:var(--red)}

/* ════════════════════════════════════════
   FORMULA STRIP
════════════════════════════════════════ */
.formula-strip{
  background:linear-gradient(90deg,#EFF6FF,#F0FDF4);
  border:1px solid #BFDBFE;border-radius:var(--radius-sm);
  padding:10px 16px;margin-top:8px;
  font-size:10.5px;color:#1E40AF;
  display:flex;gap:18px;flex-wrap:wrap;
  font-family:'DM Mono',monospace;line-height:1.6;
}
.formula-strip strong{color:var(--ink);font-family:'DM Sans',sans-serif;font-weight:600}
.slabel{font-size:10px;font-weight:700;color:var(--sub);letter-spacing:.1em;text-transform:uppercase;margin-bottom:8px;display:block}

/* ════════════════════════════════════════
   ALERT PANELS (refuel)
════════════════════════════════════════ */
.ap-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:1.25rem}
.apanel{border-radius:var(--radius);padding:14px 16px;border:1.5px solid}
.apanel.fired{background:linear-gradient(135deg,var(--red-lt),#FFF);border-color:var(--red-bd)}
.apanel.clear{background:linear-gradient(135deg,var(--green-lt),#FFF);border-color:var(--green-bd)}
.apt{font-size:9.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:10px;display:flex;align-items:center;gap:8px}
.apanel.fired .apt{color:var(--red)}.apanel.clear .apt{color:var(--green)}
.apdot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.apanel.fired .apdot{background:var(--red)}.apanel.clear .apdot{background:var(--green);animation:pulse 2s infinite}
.arow{font-size:12px;padding:6px 0;border-top:1px solid rgba(0,0,0,.05);display:flex;align-items:flex-start;gap:8px}
.arow:first-of-type{border-top:none;padding-top:0}
.apanel.fired .arow{color:#7F1D1D}.apanel.clear .arow{color:#14532D}
.snum{font-size:9.5px;font-weight:700;width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.apanel.fired .snum{background:rgba(252,165,165,.5);color:var(--red)}.apanel.clear .snum{background:rgba(134,239,172,.5);color:var(--green)}

/* ════════════════════════════════════════
   TIMELINE
════════════════════════════════════════ */
.tl{display:flex;flex-direction:column;margin-bottom:1.5rem}
.tli{display:flex}
.tls{display:flex;flex-direction:column;align-items:center;width:32px;flex-shrink:0}
.tld{width:12px;height:12px;border-radius:50%;flex-shrink:0;margin-top:18px;z-index:1;box-shadow:0 0 0 3px var(--bg),0 0 0 4px rgba(0,0,0,.06)}
.tll{flex:1;width:1px;background:var(--border);margin-top:2px}
.tli:last-child .tll{display:none}
.tlc{flex:1;margin-bottom:10px;margin-left:6px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 16px;box-shadow:var(--sh-sm);transition:box-shadow .18s}
.tlc:hover{box-shadow:var(--sh-md)}
.tlc.wv{border-left:3px solid var(--red)}.tlc.wm{border-left:3px solid var(--amber)}.tlc.wvm{border-left:3px solid var(--red)}.tlc.del{border-left:3px solid var(--amber)}
.tlch{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:11px;flex-wrap:wrap;gap:8px}
.tlvn{font-size:14px;font-weight:700;color:var(--ink);letter-spacing:-.01em;font-family:'Fraunces',serif}
.br{display:flex;gap:4px;flex-wrap:wrap}
.tb{font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;white-space:nowrap;letter-spacing:.03em;border:1px solid;display:inline-block}
.tb-ok{background:var(--green-lt);color:var(--green);border-color:var(--green-bd)}
.tb-pt{background:var(--amber-lt);color:var(--amber);border-color:var(--amber-bd)}
.tb-wv{background:var(--red-lt);color:var(--red);border-color:var(--red-bd)}
.tb-wm{background:var(--amber-lt);color:var(--amber);border-color:var(--amber-bd)}
.tb-dl{background:var(--amber-lt);color:var(--amber);border-color:var(--amber-bd)}
.tb-on{background:var(--azure-lt);color:var(--azure);border-color:var(--azure-bd)}
.tlm{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-bottom:11px}
.tmi{background:var(--bg);border-radius:5px;padding:7px 9px;border:1px solid var(--border2)}
.tmi label{font-size:8.5px;color:var(--muted);display:block;margin-bottom:3px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.tmi span{font-size:11.5px;font-weight:600;color:var(--ink);font-family:'DM Mono',monospace}
.rbs{display:flex;flex-direction:column;gap:7px}
.rbr{display:flex;align-items:center;gap:10px}
.rbl{font-size:10px;font-weight:700;width:44px;flex-shrink:0;color:var(--sub);letter-spacing:.04em}
.rbt{flex:1;height:5px;background:var(--border);border-radius:4px;overflow:hidden}
.rbf{height:100%;border-radius:4px;transition:width .5s ease}
.rbv{font-size:11.5px;font-weight:600;min-width:76px;text-align:right;font-family:'DM Mono',monospace}
.cat-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:9px}
.cat{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:600;padding:3px 9px;border-radius:20px;border:1px solid}
.cat-v{background:var(--red-lt);color:var(--red);border-color:var(--red-bd)}
.cat-m{background:var(--amber-lt);color:var(--amber);border-color:var(--amber-bd)}
.pdot{width:5px;height:5px;border-radius:50%;flex-shrink:0}
.pt-tag{display:inline-block;font-size:10.5px;font-weight:600;color:var(--amber);background:var(--amber-lt);border:1px solid var(--amber-bd);padding:2px 8px;border-radius:20px;margin-top:7px}
.dl-note{font-size:11px;color:var(--amber);background:var(--amber-lt);border:1px solid var(--amber-bd);border-radius:var(--radius-xs);padding:5px 10px;margin-top:7px;font-weight:500}
.travel-notice{font-size:11px;color:#1E40AF;background:var(--azure-lt);border:1px solid var(--azure-bd);border-radius:var(--radius-xs);padding:5px 10px;margin-top:7px;font-weight:500}

/* ════════════════════════════════════════
   BARGE ROB + TABS
════════════════════════════════════════ */
.barge-tl-tabs{display:flex;gap:0;border-bottom:2px solid var(--border);margin-bottom:1rem;background:var(--surface)}
.barge-tl-tab{padding:9px 16px;font-size:12px;font-weight:600;cursor:pointer;color:var(--muted);border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .13s;background:none;border-top:none;border-left:none;border-right:none;font-family:'DM Sans',sans-serif}
.barge-tl-tab.active{color:var(--azure);border-bottom-color:var(--azure);background:var(--azure-lt)}
.barge-tl-tab:hover:not(.active){color:var(--ink);background:var(--surface2)}

/* ════════════════════════════════════════
   VOYAGE TABLE
════════════════════════════════════════ */
.voy-wrap{overflow-x:auto;border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--sh-sm);margin-bottom:1.25rem}
.voy-tbl{width:100%;border-collapse:collapse;font-size:12px;background:var(--surface)}
.voy-tbl thead{background:var(--ink);border-bottom:none}
.voy-tbl th{color:rgba(255,255,255,.65);padding:9px 12px;text-align:left;font-size:9px;font-weight:700;letter-spacing:.1em;white-space:nowrap;text-transform:uppercase}
.voy-tbl td{padding:9px 12px;border-bottom:1px solid var(--border2);color:var(--text);vertical-align:middle;white-space:nowrap}
.voy-tbl tr:last-child td{border-bottom:none}
.voy-tbl tbody tr:hover td{background:var(--azure-lt)}
.sno{color:var(--muted);font-weight:700;text-align:center;font-family:'DM Mono',monospace;font-size:11px}
.stag{font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;white-space:nowrap;display:inline-block;border:1px solid;letter-spacing:.03em}
.st-ok{background:var(--green-lt);color:var(--green);border-color:var(--green-bd)}
.st-dl{background:var(--amber-lt);color:var(--amber);border-color:var(--amber-bd)}
.lc-rng{font-size:11px;font-weight:600;font-family:'DM Mono',monospace}
.lc-rng.in{color:var(--green)}.lc-rng.out{color:var(--amber)}

/* ════════════════════════════════════════
   NSC
════════════════════════════════════════ */
.nsc-grid{display:grid;grid-template-columns:1fr 1fr 1fr 1fr auto;gap:12px;align-items:end}
.nsc-result{background:var(--bg);border-radius:var(--radius-sm);padding:14px;margin-top:12px;display:none;border:1px solid var(--border)}
.nsc-result.show{display:block}
.nsc-rows{display:flex;flex-direction:column;gap:7px}
.nsc-row{display:flex;align-items:flex-start;gap:10px;font-size:12px;color:var(--sub)}
.nsc-row strong{color:var(--ink)}
.nsc-ok{background:var(--green-lt);border:1px solid var(--green-bd);border-radius:var(--radius-xs);padding:10px 14px;font-size:12px;color:var(--green);font-weight:600;margin-top:10px}
.nsc-warn{background:var(--red-lt);border:1px solid var(--red-bd);border-radius:var(--radius-xs);padding:10px 14px;font-size:12px;color:var(--red);font-weight:600;margin-top:10px}

/* ════════════════════════════════════════
   LEGEND
════════════════════════════════════════ */
.legend{display:flex;gap:16px;margin-bottom:1rem;flex-wrap:wrap;padding:8px 14px;background:var(--surface);border-radius:var(--radius-sm);border:1px solid var(--border);box-shadow:var(--sh-xs)}
.leg-i{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--sub);font-weight:500}
.ldot{width:8px;height:8px;border-radius:50%}

/* ════════════════════════════════════════
   CHECKLIST TABLE
════════════════════════════════════════ */
.cl-tbl{width:100%;border-collapse:collapse;font-size:12px}
.cl-tbl th{background:var(--ink);color:rgba(255,255,255,.65);padding:8px 12px;text-align:left;font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
.cl-tbl td{padding:8px 12px;border-bottom:1px solid var(--border2);vertical-align:middle}
.cl-tbl tr:hover td{background:var(--azure-lt)}

/* ════════════════════════════════════════
   SAVED RECORDS
════════════════════════════════════════ */
.rec-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 14px;border:1px solid var(--border2);
  border-radius:var(--radius-sm);margin-bottom:7px;
  background:var(--surface2);gap:12px;flex-wrap:wrap;
  transition:border-color .15s,background .15s;
}
.rec-row:hover{border-color:#CBD5E1;background:var(--surface)}
.rec-vessel{font-size:13px;font-weight:700;color:var(--ink)}
.rec-meta{font-size:11px;color:var(--sub);margin-top:2px;font-family:'DM Mono',monospace}

/* ════════════════════════════════════════
   CHART CONTAINERS
════════════════════════════════════════ */
.chart-card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:var(--radius);padding:1.25rem 1.5rem;
  box-shadow:var(--sh-sm);margin-bottom:.85rem;
}
.chart-title{font-size:13px;font-weight:700;color:var(--ink);margin-bottom:4px;font-family:'Fraunces',serif}
.chart-subtitle{font-size:11px;color:var(--muted);margin-bottom:14px}
.chart-wrap{position:relative;height:220px}
.chart-wrap-lg{position:relative;height:300px}
.charts-2col{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:1rem}
.charts-3col{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:1rem}

/* ════════════════════════════════════════
   FLATPICKR
════════════════════════════════════════ */
.flatpickr-calendar{font-family:'DM Sans',sans-serif;border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--sh-xl)}
.flatpickr-day.selected,.flatpickr-day.startRange,.flatpickr-day.endRange{background:var(--azure);border-color:var(--azure)}
.flatpickr-day.inRange{background:var(--azure-lt);border-color:var(--azure-lt);box-shadow:-5px 0 0 var(--azure-lt),5px 0 0 var(--azure-lt)}
.flatpickr-months .flatpickr-month{background:var(--ink)}
.flatpickr-current-month,.flatpickr-weekday,.flatpickr-weekdays{color:#fff}
.flatpickr-day.today{border-color:var(--azure)}

/* ════════════════════════════════════════
   CI SECTION
════════════════════════════════════════ */
.ci-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:1.1rem 1.35rem;box-shadow:var(--sh-sm)}

/* ════════════════════════════════════════
   DASHBOARD ACTIVITY FEED
════════════════════════════════════════ */
.activity-feed{display:flex;flex-direction:column;gap:0}
.activity-item{
  display:flex;align-items:flex-start;gap:12px;
  padding:10px 0;border-bottom:1px solid var(--border2);
  font-size:12px;
}
.activity-item:last-child{border-bottom:none}
.activity-dot{
  width:8px;height:8px;border-radius:50%;
  flex-shrink:0;margin-top:3px;
}
.activity-content{flex:1}
.activity-title{font-weight:600;color:var(--ink)}
.activity-detail{color:var(--sub);margin-top:1px}
.activity-time{font-family:'DM Mono',monospace;font-size:10.5px;color:var(--muted);white-space:nowrap;margin-left:auto;padding-left:12px}

/* ════════════════════════════════════════
   PROGRESS BARS
════════════════════════════════════════ */
.progress-bar-wrap{display:flex;flex-direction:column;gap:7px;margin-top:8px}
.progress-row{display:flex;flex-direction:column;gap:3px}
.progress-label-row{display:flex;justify-content:space-between;font-size:10.5px;color:var(--sub);font-weight:600}
.progress-track{height:6px;background:var(--border);border-radius:4px;overflow:hidden}
.progress-fill{height:100%;border-radius:4px;transition:width .5s ease}

/* ════════════════════════════════════════
   OUT-SEC (backward compat)
════════════════════════════════════════ */
.out-sec{display:none}
.out-sec.vis{display:block}

/* ════════════════════════════════════════
   SUM GRID (backward compat)
════════════════════════════════════════ */
.sum-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:1.25rem}
.scard{background:var(--surface);border-radius:var(--radius);padding:16px 18px;box-shadow:var(--sh-sm);border:1px solid var(--border);position:relative;overflow:hidden}
.scard::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;border-radius:2px 2px 0 0}
.scard:nth-child(1)::before{background:var(--azure)}.scard:nth-child(2)::before{background:var(--teal)}.scard:nth-child(3)::before{background:var(--amber)}.scard:nth-child(4)::before{background:var(--purple)}
.scard label{font-size:9.5px;color:var(--muted);display:block;margin-bottom:8px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
.scard span{font-size:24px;font-weight:700;letter-spacing:-.04em;font-family:'DM Mono',monospace;display:block}
.scard:nth-child(1) span{color:var(--azure)}.scard:nth-child(2) span{color:var(--teal)}.scard:nth-child(3) span{color:var(--amber)}.scard:nth-child(4) span{color:var(--purple)}
.scard small{display:block;font-size:10.5px;color:var(--muted);margin-top:5px}

/* ════════════════════════════════════════
   RESPONSIVE
════════════════════════════════════════ */
@media(max-width:900px){.g4,.g5{grid-template-columns:1fr 1fr}.kpi-grid-5,.kpi-grid-4{grid-template-columns:1fr 1fr}.charts-2col,.charts-3col{grid-template-columns:1fr}}
@media(max-width:700px){.g3{grid-template-columns:1fr 1fr}.kpi-grid-3{grid-template-columns:1fr 1fr}.nsc-grid{grid-template-columns:1fr 1fr}.ap-grid{grid-template-columns:1fr}.tlm{grid-template-columns:1fr 1fr 1fr}}
@media(max-width:768px){
  .sidebar{display:none;position:fixed;z-index:350;height:calc(100vh - var(--topbar-h) - var(--syncbar-h));width:248px;box-shadow:var(--sh-lg)}
  .sidebar.open{display:flex;flex-direction:column}
  .hamburger{display:flex}
  .page{padding:1rem}
  .topbar{padding:0 1rem;gap:10px}
  .topbar-clock{display:none}
  .topbar-page-title{display:none}
}
@media(max-width:500px){.g2{grid-template-columns:1fr}.g3{grid-template-columns:1fr}.kpi-grid-2{grid-template-columns:1fr}}

/* ════════════════════════════════════════
   PRINT
════════════════════════════════════════ */
@media print{
  @page{size:A4 landscape;margin:10mm 8mm}
  body>*{display:none!important}
  #print-only-container{display:block!important;position:static!important;width:100%!important}
  #print-only-container *{display:revert}
  .print-schedule-header{display:block!important}
  .voy-wrap{overflow:visible!important;width:100%!important;border:none!important;box-shadow:none!important}
  .voy-tbl{width:100%!important;font-size:7pt!important;border-collapse:collapse!important;table-layout:fixed!important}
  .voy-tbl th{font-size:6pt!important;padding:4px!important;background:#0D1B2A!important;color:#fff!important;-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}
  .voy-tbl td{font-size:6.5pt!important;padding:4px!important;word-break:break-word!important;border-bottom:.5pt solid #ddd!important;-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}
  .stag,.badge{font-size:5.5pt!important;padding:1px 4px!important;-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}
}

/* ════════════════════════════════════════
   AI FLOAT
════════════════════════════════════════ */
#ab-float-toggle{border-radius:50%!important;box-shadow:var(--sh-lg)!important;transition:all .2s!important}
#ab-float-toggle:hover{transform:scale(1.06)!important;box-shadow:var(--sh-xl)!important}
#ab-float-panel.visible+#ab-float-toggle,body:has(#ab-float-panel.visible) #ab-float-toggle{background:linear-gradient(135deg,#BE2B2B,#8B1717)}
.print-schedule-header{display:none}
#print-only-container{display:none;position:fixed;inset:0;z-index:99999;background:#fff;padding:0}



/* ════════════════════════════════════════════════════════
   ABPS WELCOME SCREEN v4 — exact match to screenshot
   Layout: top bar · left module grid · bottom-left headline
════════════════════════════════════════════════════════ */
#welcome-screen {
  position: fixed; inset: 0; z-index: 9999;
  width: 100vw; height: 100vh;
  overflow: hidden;
  cursor: pointer;
  font-family: 'DM Sans', system-ui, sans-serif;
}
#welcome-screen.ws-out {
  animation: wsOut .65s ease forwards;
  pointer-events: none;
}
@keyframes wsOut {
  0%   { opacity: 1; }
  100% { opacity: 0; }
}

/* ── Hero BG ── */
#ws-bg {
  position: absolute; inset: 0;
  /* Instant fallback — deep navy matches the dark illustrated scene */
  background-color: #060D1C;
  /* Primary: dramatic dark cargo ships at night — closest to screenshot mood */
  background-image: url('https://images.unsplash.com/photo-1569350818415-ffe59f37e028?w=1920&h=1080&q=88&fit=crop&crop=center&sat=-15&con=5');
  background-size: cover;
  background-position: center 45%;
  background-repeat: no-repeat;
}
/* Subtle dark overlay — left heavier so text is legible */
#ws-bg::after {
  content: '';
  position: absolute; inset: 0;
  /* Deep blue tint to shift photo toward the illustrated blue night mood */
  background: 
    linear-gradient(
      105deg,
      rgba(4,8,22,.80) 0%,
      rgba(4,12,30,.45) 40%,
      rgba(4,8,22,.30) 100%
    );
  mix-blend-mode: multiply;
}
/* Second overlay for blue toning */
#ws-bg::before {
  content: '';
  position: absolute; inset: 0;
  background: rgba(8,20,60,.22);
  z-index: 1;
  pointer-events: none;
}

/* ── Layout container ── */
#ws-layout {
  position: absolute; inset: 0;
  display: flex; flex-direction: column;
}

/* ── TOP BAR ── */
#ws-topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28px 36px 0;
  flex-shrink: 0;
}

/* Top-left: WELCOME / ABPS */
#ws-top-left {
  display: flex; flex-direction: column; gap: 3px;
}
#ws-top-left .ws-welcome {
  font-size: 9.5px; font-weight: 400;
  letter-spacing: .45em; text-transform: uppercase;
  color: rgba(255,255,255,.55);
  font-family: 'DM Mono', monospace;
  line-height: 1;
}
#ws-top-left .ws-brand {
  font-size: 9px; font-weight: 400;
  letter-spacing: .32em; text-transform: uppercase;
  color: rgba(255,255,255,.35);
  font-family: 'DM Mono', monospace;
  line-height: 1;
}

/* Top-center: dot + coordinates */
#ws-top-center {
  position: absolute; left: 50%; transform: translateX(-50%);
  display: flex; align-items: center; gap: 7px;
  padding-top: 30px;
}
#ws-coord-dot {
  width: 5px; height: 5px; border-radius: 50%;
  background: rgba(255,255,255,.55);
  flex-shrink: 0;
}
#ws-coords-text {
  font-family: 'DM Mono', monospace;
  font-size: 9.5px; letter-spacing: .18em;
  color: rgba(255,255,255,.5);
  white-space: nowrap;
}

/* Top-right: wave logo + abps/OPS */
#ws-top-right {
  display: flex; align-items: center; gap: 9px;
}
#ws-wave-icon {
  opacity: .75;
}
#ws-logo-text {
  display: flex; flex-direction: column; align-items: flex-start; gap: 0px;
}
#ws-logo-text .ws-logo-name {
  font-size: 13px; font-weight: 600;
  color: rgba(255,255,255,.8);
  font-family: 'DM Sans', sans-serif;
  letter-spacing: .08em;
  line-height: 1.1;
  text-transform: lowercase;
}
#ws-logo-text .ws-logo-sub {
  font-size: 9px; font-weight: 400;
  color: rgba(255,255,255,.38);
  font-family: 'DM Mono', monospace;
  letter-spacing: .22em;
  text-transform: uppercase;
  line-height: 1.2;
}

/* ── MIDDLE: spacer ── */
#ws-mid-spacer { flex: 1; }

/* ── LEFT SECTION: module grid + headline ── */
#ws-left {
  display: flex; flex-direction: column;
  justify-content: flex-end;
  padding: 0 0 42px 36px;
  flex-shrink: 0;
}

/* Module grid — 2 columns × 4 rows */
#ws-modules {
  display: grid;
  grid-template-columns: 120px 120px;
  grid-template-rows: repeat(4, 44px);
  gap: 1px;
  margin-bottom: 48px;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 3px;
  overflow: hidden;
  width: fit-content;
}
.ws-module {
  background: rgba(8,14,30,.65);
  backdrop-filter: blur(12px);
  display: flex; align-items: center;
  padding: 0 14px;
  font-family: 'DM Mono', monospace;
  font-size: 8px; font-weight: 400;
  letter-spacing: .22em; text-transform: uppercase;
  color: rgba(255,255,255,.55);
  border-right: 1px solid rgba(255,255,255,.06);
  border-bottom: 1px solid rgba(255,255,255,.06);
  cursor: pointer;
  transition: all .18s;
  user-select: none;
}
.ws-module:hover {
  background: rgba(21,101,192,.25);
  color: rgba(255,255,255,.9);
}
.ws-module:nth-child(2n) { border-right: none; }
.ws-module:nth-child(7),
.ws-module:nth-child(8) { border-bottom: none; }

/* ── HEADLINE ── */
#ws-headline {
  font-family: 'Fraunces', serif;
  font-size: clamp(56px, 8.5vw, 110px);
  font-weight: 300;
  line-height: .92;
  color: #ffffff;
  letter-spacing: -.04em;
  margin: 0;
  pointer-events: none;
  text-shadow: 0 2px 40px rgba(0,0,0,.3);
}
#ws-headline span {
  display: block;
}

/* Stagger-in animations */
#ws-top-left   { animation: wsFadeIn .7s .05s both; }
#ws-top-center { animation: wsFadeIn .7s .12s both; }
#ws-top-right  { animation: wsFadeIn .7s .05s both; }
#ws-modules    { animation: wsFadeIn .8s .25s both; }
#ws-headline   { animation: wsFadeIn .9s .45s both; }
@keyframes wsFadeIn {
  from { opacity:0; transform:translateY(12px); }
  to   { opacity:1; transform:translateY(0); }
}

</style>
</head>
