/*
  ══════════════════════════════════════════════════════════════════════
  VESSEL ARRIVAL AVAILABILITY CHECK — Full Window Analysis Engine
  
  Algorithm:
  1. For each barge, build a full timeline of scheduled operations.
  2. Identify ALL gaps: before first job, between each pair, after last job.
  3. Evaluate the requested time against every gap.
  4. If requested time fits in a gap → FEASIBLE (show which gap).
  5. If not → show exact blocking reason + nearest feasible slot from all gaps.
  ══════════════════════════════════════════════════════════════════════
*/

function _getBargeTimeline(bargeId, bargeName) {
  var now = new Date();

  // Build the set of vessel names that are COMPLETED & SAVED
  // so we can exclude their time windows from gap calculations
  var completedVesselKeys = new Set();
  _savedSupplies.forEach(function(r) {
    if (r.supplied && r.barge === bargeName) {
      // Key = vessel name + dateStr to uniquely identify the operation
      completedVesselKeys.add(r.vessel + '|' + r.barge);
    }
  });

  var ops = _lastSched
    .filter(function(item) {
      if (item.bargeLabel !== bargeName) return false;
      var opStart = item.bargeStart || item.eta;
      var opEtc   = item.etc;
      if (!opStart || !opEtc) return false;

      // RULE 1: Exclude if ETC is already in the past (operation fully completed)
      if (opEtc <= now) return false;

      // RULE 2: Exclude if this vessel is marked completed & saved
      // (even if ETC is technically future — it's been confirmed as done)
      var key = item.name + '|' + bargeName;
      if (completedVesselKeys.has(key)) return false;

      return true;
    })
    .map(function(item) {
      return {
        vessel: item.name,
        start:  item.bargeStart || item.eta,
        etc:    item.etc,
        vQ:     item.vQ || 0,
        mQ:     item.mQ || 0,
        sno:    item.sno
      };
    })
    .sort(function(a, b) { return a.start - b.start; });
  return ops;
}

function _findAllGaps(ops, freeFrom) {
  /*
    Returns array of gap objects — FUTURE ONLY.
    All gap starts are clamped to max(gapStart, now, freeFrom).
    Gaps that are entirely in the past are excluded.
    Completed operations are already filtered out by _getBargeTimeline.
  */
  var gaps = [];
  var now = new Date();

  // The absolute earliest anything can start:
  // must be >= now (can't go to the past) AND >= freeFrom (barge must be free)
  var absoluteEarliest = new Date(Math.max(
    now.getTime(),
    freeFrom ? freeFrom.getTime() : now.getTime()
  ));

  if (ops.length === 0) {
    gaps.push({
      type:     'empty_barge',
      gapStart: absoluteEarliest,
      gapEnd:   null,
      gapHrs:   Infinity,
      prevOp:   null,
      nextOp:   null,
      label:    'Barge fully available (no upcoming scheduled work)',
      isNow:    true
    });
    return gaps;
  }

  // Gap BEFORE the first upcoming job
  var firstOp     = ops[0];
  var beforeStart = absoluteEarliest;           // clamped to now/freeFrom
  var beforeEnd   = firstOp.start;
  var beforeHrs   = (beforeEnd - beforeStart) / 3600000;
  if (beforeHrs > 0) {
    gaps.push({
      type:     'before_first',
      gapStart: beforeStart,
      gapEnd:   beforeEnd,
      gapHrs:   beforeHrs,
      prevOp:   null,
      nextOp:   firstOp,
      label:    'Now until ' + firstOp.vessel + ' starts',
      isNow:    true
    });
  }

  // Gaps BETWEEN consecutive upcoming jobs
  for (var i = 0; i < ops.length - 1; i++) {
    var prevOp    = ops[i];
    var nextOp    = ops[i + 1];
    // Raw gap start = ETC of previous op + 1 hr travel
    var rawStart  = addHrs(prevOp.etc, 1);
    // Clamp: if this gap's raw start is in the past, use now instead
    var clampedStart = new Date(Math.max(rawStart.getTime(), now.getTime()));
    var gapEnd    = nextOp.start;
    var gapHrs    = (gapEnd - clampedStart) / 3600000;
    if (gapHrs > 0) {
      var wasClamped = clampedStart > rawStart;
      gaps.push({
        type:        'between',
        gapStart:    clampedStart,
        gapEnd:      gapEnd,
        gapHrs:      gapHrs,
        prevOp:      prevOp,
        nextOp:      nextOp,
        rawGapStart: rawStart,       // original un-clamped value (for display)
        wasClamped:  wasClamped,
        label:       'Between ' + prevOp.vessel + ' and ' + nextOp.vessel,
        isNow:       wasClamped
      });
    }
    // If gapHrs <= 0 after clamping: gap is fully in the past or zero — skip
  }

  // Gap AFTER the last upcoming job (always open-ended)
  var lastOp     = ops[ops.length - 1];
  var rawAfter   = addHrs(lastOp.etc, 1);
  var afterStart = new Date(Math.max(rawAfter.getTime(), now.getTime()));
  gaps.push({
    type:     'after_last',
    gapStart: afterStart,
    gapEnd:   null,
    gapHrs:   Infinity,
    prevOp:   lastOp,
    nextOp:   null,
    label:    'After ' + lastOp.vessel + ' completes',
    isNow:    afterStart > rawAfter
  });

  return gaps;
}

function _evalGapForJob(gap, requestedETA, jobDurationHrs, travelBuffer) {
  /*
    Evaluate whether a job fits in a gap.
    KEY RULE: earliestStart is always >= now (gaps are already clamped,
    but we double-check here as a safety net).
    A gap that has already fully elapsed is always infeasible.
  */
  var now = new Date();
  var TOTAL_NEEDED = jobDurationHrs + travelBuffer;

  // Earliest we can physically start = gap start (already clamped to now in _findAllGaps)
  // Double-clamp for safety
  var earliestStart = new Date(Math.max(gap.gapStart.getTime(), now.getTime()));

  // Latest start = must finish before gapEnd (if bounded)
  var latestStart = null;
  if (gap.gapEnd !== null) {
    latestStart = new Date(gap.gapEnd.getTime() - (jobDurationHrs + travelBuffer / 2) * 3600000);
    // If latestStart is in the past, the gap is fully expired
    if (latestStart <= now) {
      return {
        fits:          false,
        requestedOk:   false,
        earliestStart: earliestStart,
        latestStart:   null,
        reason:        'This window has already passed (latest start ' + fmt24(latestStart) + ' is in the past)'
      };
    }
  }

  // Recalculate effective gap hours from NOW (not from original gap start)
  var effectiveGapHrs = gap.gapEnd !== null
    ? (gap.gapEnd.getTime() - earliestStart.getTime()) / 3600000
    : Infinity;

  if (effectiveGapHrs < TOTAL_NEEDED) {
    return {
      fits:          false,
      requestedOk:   false,
      earliestStart: earliestStart,
      latestStart:   null,
      reason:        'Remaining window (' + effectiveGapHrs.toFixed(1) + ' hrs from now) is less than required (' + TOTAL_NEEDED.toFixed(1) + ' hrs)'
    };
  }

  // Check if requested ETA fits in this gap (strictly at that time)
  var requestedOk = false;
  if (requestedETA) {
    // Requested time must be: in the future, within gap, and leave enough time before gapEnd
    var reqInFuture  = requestedETA >= now;
    var reqInGap     = requestedETA >= gap.gapStart;
    var reqNotTooLate = latestStart === null || requestedETA <= latestStart;
    requestedOk = reqInFuture && reqInGap && reqNotTooLate;
  }

  return {
    fits:          true,
    requestedOk:   requestedOk,
    earliestStart: earliestStart,
    latestStart:   latestStart,
    reason:        null
  };
}

function checkNSCUnified() {
  var barges = _bargeConfig, states = _bargeStates;
  if (!barges || !barges.length) { alert('Run the schedule first to populate barge data.'); return; }

  var vReq = parseFloat(document.getElementById('nsc-req-v') ? document.getElementById('nsc-req-v').value : 0) || 0;
  var mReq = parseFloat(document.getElementById('nsc-req-m') ? document.getElementById('nsc-req-m').value : 0) || 0;
  var vesselName   = (document.getElementById('nsc-vessel-name') ? document.getElementById('nsc-vessel-name').value.trim() : '') || 'Unnamed Vessel';
  var etaRaw       = document.getElementById('nsc-vessel-eta') ? document.getElementById('nsc-vessel-eta').value : '';
  var requestedETA = etaRaw ? parseDT(etaRaw) : null;
  if (etaRaw && !requestedETA) { alert('Cannot parse ETA. Use the calendar picker.'); return; }
  if (!vReq && !mReq) { alert('Enter at least one fuel quantity to check.'); return; }

  // Guard: if requested ETA is more than 2 hours in the past, warn the user
  if (requestedETA) {
    var nowCheck = new Date();
    var pastHrs  = (nowCheck - requestedETA) / 3600000;
    if (pastHrs > 2) {
      if (!confirm(
        'The selected time (' + fmt24(requestedETA) + ') is ' + pastHrs.toFixed(1) + ' hours in the past.\n\n' +
        'The system will check future availability only — past slots will be excluded.\n\n' +
        'Continue?'
      )) return;
    }
  }

  // ─── Use LIVE ROB (completed supplies only, + manual overrides) ───
  var liveROBs = getAllLiveROBs();

  // ─── Per-barge full analysis ───
  var bargeResults = barges.map(function(b) {
    // Build a live-ROB-aware pseudo-state object
    var liveData = liveROBs[b.id];
    var bs = states[b.id] || {};
    // Use live ROB if available, fall back to bargeState (nomination-based) only as last resort
    var liveRv = liveData ? liveData.liveV : (bs.rv || 0);
    var liveRm = liveData ? liveData.liveM : (bs.rm || 0);
    // Keep cursor from bargeState (timing of last scheduled job)
    bs = Object.assign({}, bs, { rv: liveRv, rm: liveRm });
    if (!bs && !liveData) return null;

    // Stock check (independent of timing)
    var canV    = bs.rv >= vReq;
    var canM    = bs.rm >= mReq;
    var canFull = canV && canM;
    var shortV  = Math.max(0, vReq - bs.rv);
    var shortM  = Math.max(0, mReq - bs.rm);

    if (!canFull) {
      return {
        b: b, bs: bs,
        canFull: false, canV: canV, canM: canM,
        shortV: shortV, shortM: shortM,
        stockBlockReason: 'Insufficient stock — ' +
          (canV ? '' : 'VLSFO short by ' + shortV.toLocaleString() + ' MT ') +
          (canM ? '' : 'MGO short by ' + shortM.toLocaleString() + ' MT'),
        gaps: [], gapAnalysis: [],
        requestedFeasible: false, requestedGap: null,
        nearestSlot: null, nearestGap: null,
        robAfterV: bs.rv - Math.min(vReq, bs.rv),
        robAfterM: bs.rm - Math.min(mReq, bs.rm)
      };
    }

    var supplyV  = Math.min(vReq, bs.rv);
    var supplyM  = Math.min(mReq, bs.rm);
    var robAfterV = bs.rv - supplyV;
    var robAfterM = bs.rm - supplyM;
    var vBelowBuf = robAfterV < b.vbuf;
    var mBelowBuf = robAfterM < b.mbuf;

    // Job duration = 6 hrs setup + pumping time
    var jobDurationHrs = 6 + Math.max(supplyV / b.vtph, supplyM / b.mtph);
    // Travel buffer: 1 hr each side (sailing to/from berth)
    var travelBuffer = 1;

    // Get barge free-from time — always >= now (past cursors are irrelevant)
    var cursorTime = bs.cursor ? addHrs(bs.cursor, 1) : null;
    var nowTime    = new Date();
    var freeFrom   = cursorTime
      ? new Date(Math.max(cursorTime.getTime(), nowTime.getTime()))
      : nowTime;

    // Build full timeline (completed ops excluded) and gap list (clamped to now)
    var timeline = _getBargeTimeline(b.id, b.name);
    var gaps     = _findAllGaps(timeline, freeFrom);

    // Evaluate every gap
    var gapAnalysis = gaps.map(function(gap) {
      var evalResult = _evalGapForJob(gap, requestedETA, jobDurationHrs, travelBuffer);
      var startTime = requestedETA && eval.requestedOk ? requestedETA : eval.earliestStart;
      var etcTime   = calcETC(startTime, supplyV, supplyM, b.vtph, b.mtph);

      // Operational constraints for this slot
      var constraintReasons = [];
      if (vBelowBuf && vReq > 0) constraintReasons.push('VLSFO ROB after supply (' + Math.round(robAfterV).toLocaleString() + ' MT) below alert buffer (' + b.vbuf.toLocaleString() + ' MT)');
      if (mBelowBuf && mReq > 0) constraintReasons.push('MGO ROB after supply (' + Math.round(robAfterM).toLocaleString() + ' MT) below alert buffer (' + b.mbuf.toLocaleString() + ' MT)');

      // Reload window check against the NEXT job after this gap
      var reloadOk = true, reloadNote = '';
      if (gap.nextOp) {
        var safeV = b.vbuf * 2, safeM = b.mbuf * 2;
        var reloadHrsNeeded = Math.max(
          b.vtph > 0 ? Math.max(0, safeV - robAfterV) / b.vtph : 0,
          b.mtph > 0 ? Math.max(0, safeM - robAfterM) / b.mtph : 0
        ) + 4;
        var reloadWindowAvail = (gap.nextOp.start - etcTime) / 3600000;
        reloadOk = reloadWindowAvail >= reloadHrsNeeded || reloadHrsNeeded === 0;
        if (!reloadOk) {
          reloadNote = 'Reload window (' + reloadWindowAvail.toFixed(1) + ' hrs) shorter than needed (' + reloadHrsNeeded.toFixed(1) + ' hrs) before ' + gap.nextOp.vessel;
          constraintReasons.push(reloadNote);
        }
      }

      var feasibility = 'infeasible';
      if (eval.fits) {
        if (constraintReasons.length === 0) feasibility = 'feasible';
        else if (!reloadOk && gap.nextOp) feasibility = 'constrained';
        else feasibility = 'constrained';
      }

      return {
        gap:              gap,
        eval:             eval,
        startTime:        startTime,
        etcTime:          etcTime,
        constraintReasons: constraintReasons,
        feasibility:      feasibility,
        requestedFitsHere: eval.fits && eval.requestedOk,
        anyFitsHere:       eval.fits
      };
    });

    // Find the gap where requested ETA fits
    var requestedGap   = gapAnalysis.find(function(ga) { return ga.requestedFitsHere; }) || null;
    var requestedFeasible = !!requestedGap;

    // Find the nearest feasible slot (earliest across all gaps)
    var feasibleGaps   = gapAnalysis.filter(function(ga) { return ga.anyFitsHere; });
    var nearestGap     = feasibleGaps.length
      ? feasibleGaps.sort(function(a, b) { return a.eval.earliestStart - b.eval.earliestStart; })[0]
      : null;
    var nearestSlot    = nearestGap ? nearestGap.eval.earliestStart : null;

    // Why does requested time fail (if it does)?
    var blockingReasons = [];
    if (!requestedFeasible && requestedETA) {
      var overlaps = timeline.filter(function(op) {
        // Does the requested job window [requestedETA, requestedETA + jobDurationHrs] overlap this op?
        var jobEnd = addHrs(requestedETA, jobDurationHrs + travelBuffer);
        return requestedETA < op.etc && jobEnd > addHrs(op.start, -travelBuffer);
      });
      if (overlaps.length) {
        overlaps.forEach(function(op) {
          blockingReasons.push('Overlaps with ' + op.vessel + ' scheduled supply (' + fmt24(op.start) + ' → ' + fmt24(op.etc) + ')');
        });
      } else if (requestedETA < freeFrom) {
        var cursorRaw = bs.cursor ? addHrs(bs.cursor, 1) : null;
        if (cursorRaw && requestedETA < cursorRaw) {
          blockingReasons.push('Barge not yet free — previous job completes at ' + fmt24(bs.cursor) + ', free from ' + fmt24(cursorRaw));
        } else {
          blockingReasons.push('Requested time is in the past — barge operational baseline is ' + fmt24(freeFrom));
        }
      } else if (!feasibleGaps.length) {
        blockingReasons.push('No available gap in schedule fits this operation (' + jobDurationHrs.toFixed(1) + ' hrs needed)');
      } else {
        // The requested time is in a gap but maybe too close to boundaries
        gapAnalysis.forEach(function(ga) {
          if (!ga.eval.requestedOk && ga.eval.fits && requestedETA) {
            var beforeGap = requestedETA < ga.gap.gapStart;
            var afterGap  = ga.gap.gapEnd && requestedETA > ga.gap.gapEnd;
            var tooLate   = ga.eval.latestStart && requestedETA > ga.eval.latestStart;
            if (beforeGap) {
              blockingReasons.push('Requested time is before the barge is free in gap "' + ga.gap.label + '" (gap opens at ' + fmt24(ga.gap.gapStart) + ')');
            } else if (afterGap) {
              blockingReasons.push('Requested time is after gap "' + ga.gap.label + '" closes (gap ends at ' + fmt24(ga.gap.gapEnd) + ')');
            } else if (tooLate) {
              blockingReasons.push('Starting at requested time in gap "' + ga.gap.label + '" would run into ' + ga.gap.nextOp.vessel + ' (job ends at ' + fmt24(addHrs(requestedETA, jobDurationHrs)) + ', next starts at ' + fmt24(ga.gap.nextOp.start) + ')');
            }
          }
        });
      }
      if (!blockingReasons.length) {
        blockingReasons.push('Requested time does not fit within any available barge window');
      }
    }

    return {
      b: b, bs: bs,
      canFull: true, canV: true, canM: true,
      shortV: 0, shortM: 0, stockBlockReason: null,
      supplyV: supplyV, supplyM: supplyM,
      robAfterV: robAfterV, robAfterM: robAfterM,
      vBelowBuf: vBelowBuf, mBelowBuf: mBelowBuf,
      jobDurationHrs: jobDurationHrs,
      freeFrom: freeFrom,
      timeline: timeline,
      gaps: gaps,
      gapAnalysis: gapAnalysis,
      requestedFeasible: requestedFeasible,
      requestedGap: requestedGap,
      nearestGap: nearestGap,
      nearestSlot: nearestSlot,
      blockingReasons: blockingReasons
    };
  }).filter(Boolean);

  // ─── Categorise overall result ───
  var feasibleAtRequested    = bargeResults.filter(function(r) { return r.requestedFeasible && r.requestedGap && r.requestedGap.feasibility === 'feasible'; });
  var constrainedAtRequested = bargeResults.filter(function(r) { return r.requestedFeasible && r.requestedGap && r.requestedGap.feasibility === 'constrained'; });
  var blockedAtRequested     = bargeResults.filter(function(r) { return !r.requestedFeasible; });
  var anyFeasibleAtRequested = feasibleAtRequested.length + constrainedAtRequested.length > 0;

  var splitSuggestion = null;
  if (!anyFeasibleAtRequested && vReq > 0 && mReq > 0) {
    var vB2 = bargeResults.find(function(r) { return r.canV; });
    var mB2 = bargeResults.find(function(r) { return r.canM && (!vB2 || r.b.id !== vB2.b.id); });
    if (vB2 && mB2) splitSuggestion = { vBarge: vB2, mBarge: mB2 };
  }

  // ─── BUILD HTML ───
  var html = '';

  // Header: requested time context
  if (requestedETA) {
    var now = new Date();
    var hrsAway  = (requestedETA - now) / 3600000;
    var urgBg    = hrsAway < 0 ? 'var(--red-lt)' : hrsAway < 12 ? 'var(--red-lt)' : hrsAway < 30 ? 'var(--amber-lt)' : 'var(--azure-lt)';
    var urgBd    = hrsAway < 0 ? 'var(--red-bd)' : hrsAway < 12 ? 'var(--red-bd)' : hrsAway < 30 ? 'var(--amber-bd)' : 'var(--azure-bd)';
    var urgColor = hrsAway < 0 ? 'var(--red)'    : hrsAway < 12 ? 'var(--red)'    : hrsAway < 30 ? 'var(--amber)'   : 'var(--azure)';
    var urgLabel = hrsAway < 0 ? ' ARRIVED'   : hrsAway < 12 ? ' URGENT'      : hrsAway < 30 ? ' SOON'        : ' PLANNED';
    html += '<div style="background:' + urgBg + ';border:1.5px solid ' + urgBd + ';border-radius:10px;padding:12px 16px;margin-bottom:14px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">' +
      '<div style="font-size:22px"></div>' +
      '<div style="flex:1"><div style="font-size:13px;font-weight:700;color:var(--ink)">' + vesselName + '</div>' +
      '<div style="font-size:12px;color:var(--sub);margin-top:2px">Requested supply time: <strong>' + fmt24(requestedETA) + '</strong> &nbsp;|&nbsp; ' +
      (hrsAway >= 0 ? hrsAway.toFixed(1) + ' hrs from now' : 'Already arrived') + '</div></div>' +
      '<span style="font-size:11px;font-weight:700;padding:5px 12px;border-radius:6px;background:' + urgColor + ';color:#fff">' + urgLabel + '</span>' +
      '</div>';
  }

  // Quantities
  html += '<div style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap">' +
    (vReq > 0 ? '<div style="background:var(--azure-lt);border:1px solid var(--azure-bd);border-radius:8px;padding:8px 14px;font-size:12px;font-weight:700;color:var(--azure)">VLSFO: ' + vReq.toLocaleString() + ' MT</div>' : '') +
    (mReq > 0 ? '<div style="background:var(--teal-lt);border:1px solid #6CC9C0;border-radius:8px;padding:8px 14px;font-size:12px;font-weight:700;color:var(--teal)">MGO: ' + mReq.toLocaleString() + ' MT</div>' : '') +
    '</div>';

  // ─── MAIN VERDICT ───
  var goodList = feasibleAtRequested.length ? feasibleAtRequested : constrainedAtRequested;

  if (goodList.length) {
    var best = goodList[0];
    var ga   = best.requestedGap;
    var fColor = ga.feasibility === 'feasible' ? 'var(--green)' : 'var(--amber)';
    var fBg    = ga.feasibility === 'feasible' ? 'var(--green-lt)' : 'var(--amber-lt)';
    var fBd    = ga.feasibility === 'feasible' ? 'var(--green-bd)' : 'var(--amber-bd)';
    var fIcon  = ga.feasibility === 'feasible' ? '' : '️';
    var gapTypeLabel = ga.gap.type === 'between' ? ' Feasible between scheduled operations' :
                       ga.gap.type === 'before_first' ? ' Feasible before first scheduled job' :
                       ga.gap.type === 'after_last' ? ' Feasible after last scheduled job' : ' Barge fully available';

    html += '<div style="background:' + fBg + ';border:2px solid ' + fBd + ';border-radius:12px;padding:16px 18px;margin-bottom:14px">' +
      '<div style="display:flex;align-items:flex-start;gap:10px;margin-bottom:14px;flex-wrap:wrap">' +
      '<span style="font-size:22px">' + fIcon + '</span>' +
      '<div style="flex:1">' +
      '<div style="font-size:14px;font-weight:700;color:' + fColor + '">' + fIcon + ' Requested time is feasible — ' + best.b.name + '</div>' +
      '<div style="margin-top:6px;display:inline-flex;align-items:center;gap:8px;background:#fff;border:1.5px solid ' + fBd + ';border-radius:7px;padding:6px 12px">' +
      '<span style="font-size:16px"></span>' +
      '<span style="font-size:12px;font-weight:700;color:' + fColor + '">' + gapTypeLabel.replace(' ', '') + '</span>' +
      '</div>' +
      (ga.gap.type === 'between' ? '<div style="font-size:11.5px;color:var(--sub);margin-top:6px">Gap window: <strong>' + fmt24(ga.gap.gapStart) + '</strong> → <strong>' + fmt24(ga.gap.gapEnd) + '</strong> (' + ga.gap.gapHrs.toFixed(1) + ' hrs available)</div>' : '') +
      (ga.gap.prevOp ? '<div style="font-size:11.5px;color:var(--sub);margin-top:3px">After: <strong>' + ga.gap.prevOp.vessel + '</strong> ETC ' + fmt24(ga.gap.prevOp.etc) + '</div>' : '') +
      (ga.gap.nextOp ? '<div style="font-size:11.5px;color:var(--sub);margin-top:3px">Before: <strong>' + ga.gap.nextOp.vessel + '</strong> ETA ' + fmt24(ga.gap.nextOp.start) + '</div>' : '') +
      '</div></div>' +
      '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px">' +
      '<div class="rob-stat"><div class="rob-stat-label">Supply Start</div><div class="rob-stat-val" style="font-size:11px;color:' + fColor + '">' + fmt24(ga.startTime) + '</div></div>' +
      '<div class="rob-stat"><div class="rob-stat-label">ETC</div><div class="rob-stat-val" style="font-size:11px;color:' + fColor + '">' + fmt24(ga.etcTime) + '</div></div>' +
      '<div class="rob-stat"><div class="rob-stat-label">Duration</div><div class="rob-stat-val" style="font-size:12px">' + durStr(best.jobDurationHrs) + '</div></div>' +
      '<div class="rob-stat"><div class="rob-stat-label">Gap Available</div><div class="rob-stat-val" style="font-size:11px">' + (ga.gap.gapHrs === Infinity ? '∞ Open' : ga.gap.gapHrs.toFixed(1) + ' hrs') + '</div></div>' +
      '</div>' +
      '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:' + (ga.constraintReasons.length ? '12px' : '0') + '">' +
      (vReq > 0 ? '<div style="background:#fff;border:1px solid ' + fBd + ';border-radius:7px;padding:8px 12px"><div style="font-size:10px;font-weight:700;color:var(--sub);letter-spacing:.06em;text-transform:uppercase;margin-bottom:4px">VLSFO After Supply</div><div style="font-size:13px;font-weight:700;color:' + (best.vBelowBuf ? 'var(--red)' : 'var(--green)') + '">' + Math.round(best.robAfterV).toLocaleString() + ' MT</div><div style="font-size:10.5px;color:var(--sub)">Buffer: ' + best.b.vbuf.toLocaleString() + ' MT ' + (best.vBelowBuf ? '<span style="color:var(--red);font-weight:700"> BELOW</span>' : '<span style="color:var(--green)">✓ OK</span>') + '</div></div>' : '') +
      (mReq > 0 ? '<div style="background:#fff;border:1px solid ' + fBd + ';border-radius:7px;padding:8px 12px"><div style="font-size:10px;font-weight:700;color:var(--sub);letter-spacing:.06em;text-transform:uppercase;margin-bottom:4px">MGO After Supply</div><div style="font-size:13px;font-weight:700;color:' + (best.mBelowBuf ? 'var(--red)' : 'var(--teal)') + '">' + Math.round(best.robAfterM).toLocaleString() + ' MT</div><div style="font-size:10.5px;color:var(--sub)">Buffer: ' + best.b.mbuf.toLocaleString() + ' MT ' + (best.mBelowBuf ? '<span style="color:var(--red);font-weight:700"> BELOW</span>' : '<span style="color:var(--teal)">✓ OK</span>') + '</div></div>' : '') +
      '</div>' +
      (ga.constraintReasons.length ? '<div style="background:#fff;border:1.5px solid ' + fBd + ';border-radius:8px;padding:10px 14px">' +
        '<div style="font-size:10px;font-weight:700;color:' + fColor + ';letter-spacing:.07em;text-transform:uppercase;margin-bottom:6px"> Operational Constraints</div>' +
        ga.constraintReasons.map(function(r) { return '<div style="font-size:12px;color:var(--sub);margin-bottom:3px;display:flex;gap:8px"><span style="color:' + fColor + ';font-weight:700">•</span>' + r + '</div>'; }).join('') +
        '</div>' : '') +
      '</div>';

    // Alternatives (other barges also feasible at requested time)
    var otherGood = goodList.filter(function(r) { return r.b.id !== best.b.id; });
    if (otherGood.length) {
      html += '<div style="font-size:10px;font-weight:700;color:var(--sub);letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px">Also feasible at requested time:</div>' +
        '<div style="display:flex;flex-direction:column;gap:6px;margin-bottom:14px">' +
        otherGood.map(function(r) {
          var ga2 = r.requestedGap;
          var ac = ga2.feasibility === 'feasible' ? 'var(--green)' : 'var(--amber)';
          var ab = ga2.feasibility === 'feasible' ? 'var(--green-lt)' : 'var(--amber-lt)';
          return '<div style="background:' + ab + ';border:1px solid;border-radius:8px;padding:9px 14px;font-size:12px;display:flex;gap:10px;align-items:center;flex-wrap:wrap">' +
            '<strong> ' + r.b.name + '</strong>' +
            '<span>' + ga2.gap.label + '</span>' +
            '<span>→ ETC: ' + fmt24(ga2.etcTime) + '</span>' +
            '<span style="font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:4px;background:' + ac + ';color:#fff">' + ga2.feasibility.toUpperCase() + '</span>' +
            '</div>';
        }).join('') + '</div>';
    }

    // Show blocked barges (with nearest feasible)
    if (blockedAtRequested.length) {
      html += '<div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 14px;margin-bottom:14px">' +
        '<div style="font-size:10px;font-weight:700;color:var(--sub);letter-spacing:.07em;text-transform:uppercase;margin-bottom:8px">Other barges — not feasible at requested time:</div>' +
        blockedAtRequested.map(function(r) {
          return '<div style="border-top:1px solid var(--border2);padding:7px 0;font-size:12px">' +
            '<strong style="color:var(--ink)"> ' + r.b.name + '</strong> — ' +
            '<span style="color:var(--red)">' + (r.blockingReasons[0] || r.stockBlockReason || 'Not available') + '</span>' +
            (r.nearestSlot ? ' &nbsp;→&nbsp; Nearest: <strong style="color:var(--azure)">' + fmt24(r.nearestSlot) + '</strong> (' + r.nearestGap.gap.label + ')' : '') +
            '</div>';
        }).join('') + '</div>';
    }

  } else if (splitSuggestion) {
    var vBx = splitSuggestion.vBarge, mBx = splitSuggestion.mBarge;
    html += '<div style="background:var(--amber-lt);border:2px solid var(--amber-bd);border-radius:12px;padding:16px 18px;margin-bottom:14px">' +
      '<div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">' +
      '<span style="font-size:20px"></span><div>' +
      '<div style="font-size:14px;font-weight:700;color:var(--amber)">Split Supply — Two Barges Required</div>' +
      '<div style="font-size:11.5px;color:var(--amber);margin-top:2px;font-style:italic">No single barge can supply both fuels. Coordinate simultaneous operations.</div>' +
      '</div></div>' +
      '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">' +
      ['VLSFO','MGO'].map(function(fuel, fi) {
        var r = fi === 0 ? vBx : mBx;
        var qty = fi === 0 ? vReq : mReq;
        var c   = fi === 0 ? 'var(--azure)' : 'var(--teal)';
        var bd  = fi === 0 ? 'var(--azure-bd)' : '#6CC9C0';
        var nearGA = r.nearestGap;
        return '<div style="background:#fff;border:1.5px solid ' + bd + ';border-radius:10px;padding:12px">' +
          '<div style="font-size:10px;font-weight:700;color:' + c + ';letter-spacing:.07em;text-transform:uppercase;margin-bottom:8px"> ' + r.b.name + ' — ' + fuel + '</div>' +
          '<div style="font-size:12px;color:var(--sub)">Supply: <strong style="color:var(--green)">' + qty.toLocaleString() + ' MT ✓</strong></div>' +
          (nearGA ? '<div style="font-size:12px;color:var(--sub)">Nearest slot: <strong>' + fmt24(nearGA.eval.earliestStart) + '</strong></div><div style="font-size:11px;color:var(--sub)">' + nearGA.gap.label + '</div>' : '') +
          '</div>';
      }).join('') +
      '</div></div>';

  } else {
    //  Not feasible at requested time on ANY barge
    html += '<div style="background:var(--red-lt);border:2px solid var(--red-bd);border-radius:12px;padding:16px 18px;margin-bottom:14px">' +
      '<div style="display:flex;align-items:flex-start;gap:10px;margin-bottom:14px">' +
      '<span style="font-size:22px"></span>' +
      '<div><div style="font-size:14px;font-weight:700;color:var(--red)">Requested Time Is Not Feasible</div>' +
      '<div style="font-size:12px;color:var(--red);margin-top:4px">' + fmt24(requestedETA) + ' cannot be accommodated on any barge. See analysis and nearest feasible times below.</div>' +
      '</div></div>';

    bargeResults.forEach(function(r) {
      if (!r.canFull) {
        // Stock insufficient
        html += '<div style="background:#fff;border:1.5px solid var(--red-bd);border-radius:10px;padding:12px 14px;margin-bottom:10px">' +
          '<div style="font-size:12px;font-weight:700;color:var(--ink);margin-bottom:6px"> ' + r.b.name + ' — <span style="color:var(--red)">Stock Insufficient</span></div>' +
          '<div style="font-size:12px;color:var(--sub)">' + r.stockBlockReason + '</div>' +
          '<div style="font-size:11px;color:var(--muted);margin-top:4px">Action required: arrange barge refuelling before this supply.</div>' +
          '</div>';
        return;
      }

      var bestNearest = r.nearestGap;
      html += '<div style="background:#fff;border:1.5px solid var(--red-bd);border-radius:10px;padding:12px 14px;margin-bottom:10px">' +
        '<div style="font-size:12px;font-weight:700;color:var(--ink);margin-bottom:8px;display:flex;align-items:center;gap:8px;flex-wrap:wrap">' +
        ' ' + r.b.name +
        '<span style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:4px;background:var(--red-lt);color:var(--red);border:1px solid var(--red-bd)"> BLOCKED AT ' + fmt24(requestedETA) + '</span>' +
        '</div>';

      // Blocking reasons
      html += '<div style="margin-bottom:10px">' +
        '<div style="font-size:10px;font-weight:700;color:var(--red);letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px">Why the requested time fails:</div>' +
        r.blockingReasons.map(function(reason) {
          return '<div style="font-size:12px;color:var(--sub);display:flex;gap:8px;margin-bottom:3px">' +
            '<span style="color:var(--red);font-weight:700;flex-shrink:0">✗</span>' + reason + '</div>';
        }).join('') + '</div>';

      // All available windows (gaps)
      html += '<div style="font-size:10px;font-weight:700;color:var(--sub);letter-spacing:.06em;text-transform:uppercase;margin-bottom:6px">All available windows on this barge:</div>';

      r.gapAnalysis.forEach(function(ga) {
        var isNearest = bestNearest && ga === bestNearest;
        var gBg   = isNearest ? 'var(--green-lt)' : 'var(--bg)';
        var gBd   = isNearest ? 'var(--green-bd)' : 'var(--border)';
        var gColor = isNearest ? 'var(--green)' : 'var(--sub)';
        var nowTag = ga.gap.isNow ? '<span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:4px;background:var(--azure-lt);color:var(--azure);border:1px solid var(--azure-bd)">⏱ From Now</span>' : '';
        html += '<div style="background:' + gBg + ';border:1.5px solid ' + gBd + ';border-radius:8px;padding:10px 12px;margin-bottom:6px">' +
          '<div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;flex-wrap:wrap">' +
          (isNearest ? '<span style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:4px;background:var(--green);color:#fff">⭐ NEAREST FEASIBLE</span>' : '') +
          nowTag +
          '<span style="font-size:11px;font-weight:700;color:' + gColor + '">' + ga.gap.label + '</span>' +
          '<span style="font-size:10px;color:var(--muted)">Available: ' + (ga.gap.gapHrs === Infinity ? 'Open-ended' : ga.gap.gapHrs.toFixed(1) + ' hrs') + '</span>' +
          (ga.gap.prevOp ? '<span style="font-size:10px;color:var(--muted)">After ' + ga.gap.prevOp.vessel + ' ETC ' + fmt24(ga.gap.prevOp.etc) + '</span>' : '') +
          (ga.gap.nextOp ? '<span style="font-size:10px;color:var(--muted)">Before ' + ga.gap.nextOp.vessel + ' ETA ' + fmt24(ga.gap.nextOp.start) + '</span>' : '') +
          '</div>';

        if (ga.eval.fits) {
          var delayHrs = requestedETA ? Math.max(0, (ga.eval.earliestStart - requestedETA) / 3600000) : 0;
          var nowMs    = new Date().getTime();
          var fromNow  = (ga.eval.earliestStart.getTime() - nowMs) / 3600000;
          html += '<div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:6px">' +
            '<div class="rob-stat"><div class="rob-stat-label">Earliest Start</div><div class="rob-stat-val" style="font-size:11px;color:' + gColor + '">' + fmt24(ga.eval.earliestStart) + '</div><div class="rob-stat-sub">' + (fromNow <= 0.1 ? 'Now' : fromNow.toFixed(1) + ' hrs from now') + '</div></div>' +
            '<div class="rob-stat"><div class="rob-stat-label">ETC</div><div class="rob-stat-val" style="font-size:11px;color:' + gColor + '">' + fmt24(ga.etcTime) + '</div></div>' +
            '<div class="rob-stat"><div class="rob-stat-label">Delay vs Requested</div><div class="rob-stat-val" style="font-size:11px;color:' + (delayHrs > 0 ? 'var(--amber)' : 'var(--green)') + '">' + (delayHrs > 0 ? '+' + delayHrs.toFixed(1) + ' hrs' : 'On time') + '</div></div>' +
            '<div class="rob-stat"><div class="rob-stat-label">Status</div><div class="rob-stat-val" style="font-size:10px">' +
            (ga.constraintReasons.length ? '<span style="color:var(--amber)"> Constrained</span>' : '<span style="color:var(--green)">✓ Clear</span>') + '</div></div>' +
            '</div>';
          if (ga.constraintReasons.length) {
            html += '<div style="font-size:11px;color:var(--amber);margin-top:5px"> ' + ga.constraintReasons[0] + '</div>';
          }
        } else {
          html += '<div style="font-size:11.5px;color:var(--red)">' + ga.eval.reason + '</div>';
        }
        html += '</div>';
      });

      html += '</div>';
    });
    html += '</div>';
  }

  // ─── FULL SUMMARY TABLE ───
  html += '<div style="margin-top:8px">' +
    '<div style="font-size:10px;font-weight:700;color:var(--sub);letter-spacing:.07em;text-transform:uppercase;margin-bottom:8px">' +
    'Complete Window Analysis — All Barges at ' + (requestedETA ? fmt24(requestedETA) : 'requested time') + '</div>' +
    '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:12px;background:var(--surface);border-radius:10px;overflow:hidden;border:1px solid var(--border)">' +
    '<thead><tr style="background:linear-gradient(135deg,var(--ink),var(--ink2))">' +
    ['Barge','VLSFO ROB','MGO ROB','Stock OK?','Requested Time','Fits In Window','Nearest Feasible','Delay','ROB After V','ROB After M','Verdict'].map(function(h) {
      return '<th style="color:#fff;padding:8px 10px;text-align:left;font-size:9.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap">' + h + '</th>';
    }).join('') + '</tr></thead><tbody>' +
    bargeResults.map(function(r, i) {
      var ga3       = r.requestedGap;
      var nearest3  = r.nearestGap;
      var delayHrs3 = requestedETA && nearest3 ? Math.max(0, (nearest3.eval.earliestStart - requestedETA) / 3600000) : 0;
      var verd = !r.canFull ? ' No Stock' : r.requestedFeasible ? (ga3.feasibility === 'feasible' ? ' Feasible' : ' Constrained') : ' Blocked';
      var vC   = !r.canFull ? 'var(--red)' : r.requestedFeasible ? (ga3.feasibility === 'feasible' ? 'var(--green)' : 'var(--amber)') : 'var(--red)';
      var vBG  = !r.canFull ? 'var(--red-lt)' : r.requestedFeasible ? (ga3.feasibility === 'feasible' ? 'var(--green-lt)' : 'var(--amber-lt)') : 'var(--red-lt)';
      return '<tr style="border-bottom:1px solid var(--border2);background:' + (i % 2 === 0 ? '#fff' : 'var(--surface2)') + '">' +
        '<td style="padding:8px 10px;font-weight:700;white-space:nowrap"> ' + r.b.name + '</td>' +
        '<td style="padding:8px 10px;font-family:\'DM Mono\',monospace;font-weight:600;color:' + (r.canV ? 'var(--green)' : 'var(--red)') + ';white-space:nowrap">' + Math.round(r.bs.rv).toLocaleString() + ' MT</td>' +
        '<td style="padding:8px 10px;font-family:\'DM Mono\',monospace;font-weight:600;color:' + (r.canM ? 'var(--teal)' : 'var(--red)') + ';white-space:nowrap">' + Math.round(r.bs.rm).toLocaleString() + ' MT</td>' +
        '<td style="padding:8px 10px"><span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:4px;background:' + (r.canFull ? 'var(--green-lt)' : 'var(--red-lt)') + ';color:' + (r.canFull ? 'var(--green)' : 'var(--red)') + ';border:1px solid ' + (r.canFull ? 'var(--green-bd)' : 'var(--red-bd)') + '">' + (r.canFull ? '✓ Yes' : '✗ No') + '</span></td>' +
        '<td style="padding:8px 10px"><span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:4px;background:' + (r.requestedFeasible ? 'var(--green-lt)' : 'var(--red-lt)') + ';color:' + (r.requestedFeasible ? 'var(--green)' : 'var(--red)') + ';border:1px solid ' + (r.requestedFeasible ? 'var(--green-bd)' : 'var(--red-bd)') + '">' + (r.requestedFeasible ? '✓ Fits' : '✗ Blocked') + '</span></td>' +
        '<td style="padding:8px 10px;font-size:11px;white-space:nowrap">' + (r.requestedFeasible && ga3 ? ga3.gap.label : (r.nearestGap ? r.nearestGap.gap.label : '—')) + '</td>' +
        '<td style="padding:8px 10px;font-size:11px;font-family:\'DM Mono\',monospace;white-space:nowrap">' + (nearest3 ? fmt24(nearest3.eval.earliestStart) : '<span style="color:var(--red)">No stock</span>') + '</td>' +
        '<td style="padding:8px 10px;font-size:11px;font-family:\'DM Mono\',monospace;white-space:nowrap;color:' + (delayHrs3 > 0 ? 'var(--amber)' : 'var(--green)') + '">' + (nearest3 ? (delayHrs3 > 0 ? '+' + delayHrs3.toFixed(1) + ' hrs' : 'On time') : '—') + '</td>' +
        '<td style="padding:8px 10px;font-weight:600;color:' + (r.vBelowBuf ? 'var(--red)' : 'var(--green)') + ';font-family:\'DM Mono\',monospace;white-space:nowrap">' + (vReq > 0 ? Math.round(r.robAfterV).toLocaleString() + ' MT' : '—') + '</td>' +
        '<td style="padding:8px 10px;font-weight:600;color:' + (r.mBelowBuf ? 'var(--red)' : 'var(--teal)') + ';font-family:\'DM Mono\',monospace;white-space:nowrap">' + (mReq > 0 ? Math.round(r.robAfterM).toLocaleString() + ' MT' : '—') + '</td>' +
        '<td style="padding:8px 10px"><span style="font-size:10.5px;font-weight:700;padding:3px 9px;border-radius:5px;background:' + vBG + ';color:' + vC + ';white-space:nowrap">' + verd + '</span></td>' +
        '</tr>';
    }).join('') +
    '</tbody></table></div></div>';

  // ─── PERSIST AS CARD ───
  var checkId = 'nsc_' + Date.now();
  var topStatus = anyFeasibleAtRequested
    ? (feasibleAtRequested.length ? ' Feasible at Requested Time' : ' Feasible with Constraints')
    : ' Not Feasible at Requested Time';
  var topColor  = anyFeasibleAtRequested ? (feasibleAtRequested.length ? 'var(--green)' : 'var(--amber)') : 'var(--red)';

  var card = document.createElement('div');
  card.id = checkId;
  card.style.cssText = 'background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius);margin-bottom:14px;box-shadow:var(--shadow);overflow:hidden;';
  card.innerHTML =
    '<div style="background:linear-gradient(135deg,var(--ink),var(--ink2));padding:12px 16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">' +
    '<div style="flex:1;min-width:0">' +
    '<div style="font-size:13px;font-weight:700;color:#fff;font-family:Fraunces,serif">' + vesselName + '</div>' +
    '<div style="font-size:11px;color:rgba(255,255,255,.55);margin-top:2px;font-family:\'DM Mono\',monospace">' +
    (requestedETA ? fmt24(requestedETA) : 'No ETA') + ' &nbsp;|&nbsp; ' +
    (vReq > 0 ? 'VLSFO ' + vReq.toLocaleString() + ' MT ' : '') + (mReq > 0 ? 'MGO ' + mReq.toLocaleString() + ' MT' : '') +
    ' &nbsp;|&nbsp; Checked: ' + fmt24(new Date()) + '</div></div>' +
    '<span style="font-size:11px;font-weight:700;padding:4px 12px;border-radius:6px;background:' + topColor + ';color:#fff;white-space:nowrap">' + topStatus + '</span>' +
    '<div style="display:flex;gap:6px;flex-shrink:0">' +
    '<button onclick="addNSCToNominations(\'' + checkId + '\')" style="padding:6px 12px;background:var(--azure);color:#fff;border:none;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;font-family:\'DM Sans\',sans-serif;white-space:nowrap"> Add to Nominations</button>' +
    '<button onclick="deleteNSCCheck(\'' + checkId + '\')" style="padding:6px 10px;background:rgba(255,255,255,.12);color:rgba(255,255,255,.8);border:1px solid rgba(255,255,255,.2);border-radius:6px;font-size:11px;cursor:pointer;font-family:\'DM Sans\',sans-serif"></button>' +
    '</div></div>' +
    '<div style="padding:14px 16px">' + html + '</div>';

  card._nscData = { vesselName: vesselName, vesselETA: requestedETA ? requestedETA.toISOString() : null, vReq: vReq, mReq: mReq };
  _nscCheckData[checkId] = card._nscData;
  var list = document.getElementById('nsc-checks-list');
  if (list) {
    list.insertBefore(card, list.firstChild);
    var hdrEl = document.getElementById('nsc-checks-header');
    if (hdrEl) hdrEl.style.display = 'block';
  }
}

function _buildForwardImpactPanel(a) {
  var nvi = a.nextVesselImpact;
  if (!nvi) return '';
  var ok = nvi.canReloadBeforeNext && nvi.canSupplyNext;
  var borderColor = ok ? 'var(--green-bd)' : nvi.canSupplyNext ? 'var(--amber-bd)' : 'var(--red-bd)';
  var bgColor     = ok ? 'var(--green-lt)' : nvi.canSupplyNext ? 'var(--amber-lt)' : 'var(--red-lt)';
  var textColor   = ok ? 'var(--green)'    : nvi.canSupplyNext ? 'var(--amber)'    : 'var(--red)';
  return '<div style="background:' + bgColor + ';border:1.5px solid ' + borderColor + ';border-radius:9px;padding:12px 14px;margin-top:10px">' +
    '<div style="font-size:10.5px;font-weight:700;color:' + textColor + ';letter-spacing:.07em;text-transform:uppercase;margin-bottom:8px">⏭ Forward Impact — Next Committed Vessel</div>' +
    '<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:8px">' +
    '<div class="rob-stat"><div class="rob-stat-label">Next Vessel</div><div class="rob-stat-val" style="font-size:11px">' + nvi.vessel + '</div></div>' +
    '<div class="rob-stat"><div class="rob-stat-label">Arrives At</div><div class="rob-stat-val" style="font-size:11px">' + fmt24(nvi.eta) + '</div></div>' +
    '<div class="rob-stat"><div class="rob-stat-label">Reload Window</div><div class="rob-stat-val" style="font-size:11px;color:' + (nvi.reloadWindowAvailable >= nvi.reloadWindowNeeded ? 'var(--green)' : 'var(--red)') + '">' + nvi.reloadWindowAvailable.toFixed(1) + ' hrs</div></div>' +
    '</div>' +
    '<div style="font-size:12px;color:' + textColor + ';font-weight:500">' +
    (nvi.canReloadBeforeNext ? '✓ Sufficient reload window before next vessel.' :
      'Reload window (' + nvi.reloadWindowAvailable.toFixed(1) + ' hrs available) is shorter than needed (' + nvi.reloadWindowNeeded.toFixed(1) + ' hrs) — risk of delayed service to ' + nvi.vessel + '.') +
    (nvi.canSupplyNext ? '' : ' Post-supply ROB also insufficient to serve ' + nvi.vessel + ' without refuelling.') +
    '</div></div>';
}

/* ─── NSC PERSISTENT CHECK MANAGEMENT ─── */
// _nscCheckData declared at top of script

function clearAllNSCChecks() {
  if (!confirm('Clear all availability checks?')) return;
  const list = document.getElementById('nsc-checks-list');
